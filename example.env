HOST=localhost
PORT=3000

POSTGRES_USER=REPLACE_WITH_DATABASE_USERNAME
POSTGRES_PASSWORD=REPLACE_WITH_32_BYTE_RANDOM_SECRET
POSTGRES_DB=REPLACE_WITH_DATABASE_NAME
DATABASE_URL=postgresql+psycopg://REPLACE_WITH_DATABASE_USERNAME:REPLACE_WITH_32_BYTE_RANDOM_SECRET@localhost:5432/REPLACE_WITH_DATABASE_NAME

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_32_BYTE_RANDOM_SECRET
REDIS_DB=0

JWT_SECRET=REPLACE_WITH_32_BYTE_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=refresh_token
COOKIE_SECURE=false

SYSTEM_ADMIN_USERNAME=admin
SYSTEM_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

INVITATION_DEFAULT_EXPIRE_HOURS=72
INVITATION_MAX_EXPIRE_HOURS=720
INVITATION_TOKEN_BYTES=32

# Backend issues short-lived browser permissions for the tile proxy. The
# Yandex API key belongs only to the map-proxy service and is never exposed by
# the FastAPI application.
MAP_TILES_ENABLED=false
MAP_TILES_SIGNING_SECRET=REPLACE_WITH_32_BYTE_RANDOM_SECRET
MAP_TILE_SESSION_TTL_SECONDS=600
MAP_MAX_BUILDINGS_PER_VIEWPORT=2000

# Map proxy settings. Set MAP_TILES_ENABLED=true only after both secrets below
# are configured and the applicable Yandex Maps tariff permits proxy caching.
MAP_PROXY_PORT=8088
YANDEX_TILES_API_KEY=REPLACE_WITH_YANDEX_TILES_API_KEY
MAP_TILES_CACHE_SIZE=2g
MAP_TILES_CACHE_TTL=12h
MAP_TILES_CACHE_INACTIVE=7d
MAP_TILES_RPS=28
