    "~^9:((?:[0-9]|[1-9][0-9]{1}|[1-4][0-9]{2}|50[0-9]{1}|510|511))$" 1;
    "~^10:((?:[0-9]|[1-9][0-9]{1}|[1-9][0-9]{2}|10[0-1][0-9]{1}|102[0-2]|1023))$" 1;
    "~^11:((?:[0-9]|[1-9][0-9]{1}|[1-9][0-9]{2}|1[0-9]{3}|20[0-3][0-9]{1}|204[0-6]|2047))$" 1;
    "~^12:((?:[0-9]|[1-9][0-9]{1}|[1-9][0-9]{2}|[1-3][0-9]{3}|40[0-8][0-9]{1}|409[0-4]|4095))$" 1;
    "~^13:((?:[0-9]|[1-9][0-9]{1}|[1-9][0-9]{2}|[1-7][0-9]{3}|80[0-9]{2}|81[0-8][0-9]{1}|8190|8191))$" 1;
    "~^14:((?:[0-9]|[1-9][0-9]{1}|[1-9][0-9]{2}|[1-9][0-9]{3}|1[0-5][0-9]{3}|16[0-2][0-9]{2}|163[0-7][0-9]{1}|1638[0-2]|16383))$" 1;
    "~^15:((?:[0-9]|[1-9][0-9]{1}|[1-9][0-9]{2}|[1-9][0-9]{3}|[1-2][0-9]{4}|3[0-1][0-9]{3}|32[0-6][0-9]{2}|327[0-5][0-9]{1}|3276[0-6]|32767))$" 1;
    "~^16:((?:[0-9]|[1-9][0-9]{1}|[1-9][0-9]{2}|[1-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4]|65535))$" 1;
    "~^17:((?:[0-9]|[1-9][0-9]{1}|[1-9][0-9]{2}|[1-9][0-9]{3}|[1-9][0-9]{4}|1[0-2][0-9]{4}|130[0-9]{3}|1310[0-6][0-9]{1}|131070|131071))$" 1;
    "~^18:((?:[0-9]|[1-9][0-9]{1}|[1-9][0-9]{2}|[1-9][0-9]{3}|[1-9][0-9]{4}|1[0-9]{5}|2[0-5][0-9]{4}|26[0-1][0-9]{3}|2620[0-9]{2}|2621[0-3][0-9]{1}|26214[0-2]|262143))$" 1;
    "~^19:((?:[0-9]|[1-9][0-9]{1}|[1-9][0-9]{2}|[1-9][0-9]{3}|[1-9][0-9]{4}|[1-4][0-9]{5}|5[0-1][0-9]{4}|52[0-3][0-9]{3}|524[0-1][0-9]{2}|5242[0-7][0-9]{1}|52428[0-6]|524287))$" 1;
    "~^20:((?:[0-9]|[1-9][0-9]{1}|[1-9][0-9]{2}|[1-9][0-9]{3}|[1-9][0-9]{4}|[1-9][0-9]{5}|10[0-3][0-9]{4}|104[0-7][0-9]{3}|1048[0-4][0-9]{2}|10485[0-6][0-9]{1}|104857[0-4]|1048575))$" 1;
}

map "$tile_z:$tile_y" $tile_y_valid {
    default 0;
    "~^0:(0)$" 1;
    "~^1:((?:0|1))$" 1;
    "~^2:((?:[0-2]|3))$" 1;
    "~^3:((?:[0-6]|7))$" 1;
    "~^4:((?:[0-9]|1[0-4]|15))$" 1;
    "~^5:((?:[0-9]|[1-2][0-9]{1}|30|31))$" 1;
    "~^6:((?:[0-9]|[1-5][0-9]{1}|6[0-2]|63))$" 1;
    "~^7:((?:[0-9]|[1-9][0-9]{1}|1[0-1][0-9]{1}|12[0-6]|127))$" 1;
    "~^8:((?:[0-9]|[1-9][0-9]{1}|1[0-9]{2}|2[0-4][0-9]{1}|25[0-4]|255))$" 1;
    "~^9:((?:[0-9]|[1-9][0-9]{1}|[1-4][0-9]{2}|50[0-9]{1}|510|511))$" 1;
    "~^10:((?:[0-9]|[1-9][0-9]{1}|[1-9][0-9]{2}|10[0-1][0-9]{1}|102[0-2]|1023))$" 1;
    "~^11:((?:[0-9]|[1-9][0-9]{1}|[1-9][0-9]{2}|1[0-9]{3}|20[0-3][0-9]{1}|204[0-6]|2047))$" 1;
    "~^12:((?:[0-9]|[1-9][0-9]{1}|[1-9][0-9]{2}|[1-3][0-9]{3}|40[0-8][0-9]{1}|409[0-4]|4095))$" 1;
    "~^13:((?:[0-9]|[1-9][0-9]{1}|[1-9][0-9]{2}|[1-7][0-9]{3}|80[0-9]{2}|81[0-8][0-9]{1}|8190|8191))$" 1;
    "~^14:((?:[0-9]|[1-9][0-9]{1}|[1-9][0-9]{2}|[1-9][0-9]{3}|1[0-5][0-9]{3}|16[0-2][0-9]{2}|163[0-7][0-9]{1}|1638[0-2]|16383))$" 1;
    "~^15:((?:[0-9]|[1-9][0-9]{1}|[1-9][0-9]{2}|[1-9][0-9]{3}|[1-2][0-9]{4}|3[0-1][0-9]{3}|32[0-6][0-9]{2}|327[0-5][0-9]{1}|3276[0-6]|32767))$" 1;
    "~^16:((?:[0-9]|[1-9][0-9]{1}|[1-9][0-9]{2}|[1-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]{1}|6553[0-4]|65535))$" 1;
    "~^17:((?:[0-9]|[1-9][0-9]{1}|[1-9][0-9]{2}|[1-9][0-9]{3}|[1-9][0-9]{4}|1[0-2][0-9]{4}|130[0-9]{3}|1310[0-6][0-9]{1}|131070|131071))$" 1;
    "~^18:((?:[0-9]|[1-9][0-9]{1}|[1-9][0-9]{2}|[1-9][0-9]{3}|[1-9][0-9]{4}|1[0-9]{5}|2[0-5][0-9]{4}|26[0-1][0-9]{3}|2620[0-9]{2}|2621[0-3][0-9]{1}|26214[0-2]|262143))$" 1;
    "~^19:((?:[0-9]|[1-9][0-9]{1}|[1-9][0-9]{2}|[1-9][0-9]{3}|[1-9][0-9]{4}|[1-4][0-9]{5}|5[0-1][0-9]{4}|52[0-3][0-9]{3}|524[0-1][0-9]{2}|5242[0-7][0-9]{1}|52428[0-6]|524287))$" 1;
    "~^20:((?:[0-9]|[1-9][0-9]{1}|[1-9][0-9]{2}|[1-9][0-9]{3}|[1-9][0-9]{4}|[1-9][0-9]{5}|10[0-3][0-9]{4}|104[0-7][0-9]{3}|1048[0-4][0-9]{2}|10485[0-6][0-9]{1}|104857[0-4]|1048575))$" 1;
}

upstream yandex_tiles {
    server tiles.api-maps.yandex.ru:443;
    keepalive 32;
}

server {
    listen 8080;
    access_log /var/log/nginx/access.log tile_access;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok\n';
    }

    location ~ "^/map/tiles/(?<tile_z>[0-9]{1,2})/(?<tile_x>[0-9]{1,7})/(?<tile_y>[0-9]{1,7})\.png$" {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        if ($tile_query_valid = 0) { return 400; }
        if ($tile_x_valid = 0) { return 400; }
        if ($tile_y_valid = 0) { return 400; }

        secure_link $arg_signature,$arg_expires;
        secure_link_md5 "$secure_link_expires map-tiles ${MAP_TILES_SIGNING_SECRET}";
        if ($secure_link = "") { return 403; }
        if ($secure_link = "0") { return 410; }

        proxy_cache map_tiles;
        proxy_cache_key "$tile_z:$tile_x:$tile_y";
        proxy_cache_methods GET HEAD;
        proxy_cache_valid 200 ${MAP_TILES_CACHE_TTL};
        proxy_cache_valid any 0s;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 10s;
        proxy_cache_lock_age 10s;
        proxy_ignore_headers X-Accel-Expires Expires Cache-Control Set-Cookie Vary;
        add_header X-Tile-Cache $upstream_cache_status always;

        proxy_pass http://127.0.0.1:8081/origin/$tile_z/$tile_x/$tile_y.png;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    location / {
        return 404;
    }
}

# Cache misses alone reach this listener. The global limiter therefore runs
# after cache lookup and cannot be bypassed by changing client IP addresses.
server {
    listen 127.0.0.1:8081;
    access_log off;
    # Nginx upstream error messages include the complete upstream URL. Because
    # the Yandex API key is necessarily a query parameter, suppress this
    # listener's error log rather than risk writing the key to container logs.
    error_log /dev/null crit;

    location ~ "^/origin/(?<tile_z>[0-9]{1,2})/(?<tile_x>[0-9]{1,7})/(?<tile_y>[0-9]{1,7})\.png$" {
        limit_req zone=map_origin_rate burst=56;
        limit_req_status 429;
        limit_conn map_origin_connections 64;
        limit_conn_status 429;

        proxy_pass https://yandex_tiles/v1/tiles/?x=$tile_x&y=$tile_y&z=$tile_z&lang=ru_RU&l=map&projection=web_mercator&apikey=${YANDEX_TILES_API_KEY};
        proxy_ssl_server_name on;
        proxy_ssl_name tiles.api-maps.yandex.ru;
        proxy_set_header Host tiles.api-maps.yandex.ru;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
        proxy_hide_header Set-Cookie;
    }

    location / {
        return 404;
    }
}
