proxy_cache_path /var/cache/nginx/map-tiles
    levels=1:2
    keys_zone=map_tiles:20m
    max_size=${MAP_TILES_CACHE_SIZE}
    inactive=${MAP_TILES_CACHE_INACTIVE}
    use_temp_path=off;

# Every origin request uses the same key. This is deliberately global for the
# whole proxy, not per browser or per source IP.
map $host $map_origin_rate_key {
    default "yandex-tiles-origin";
}
limit_req_zone $map_origin_rate_key zone=map_origin_rate:10m rate=${MAP_TILES_RPS}r/s;
limit_conn_zone $map_origin_rate_key zone=map_origin_connections:10m;

map $args $tile_query_valid {
    default 0;
    "~^expires=[0-9]{10}&signature=[A-Za-z0-9_-]{22}$" 1;
}

map "$tile_z:$tile_x" $tile_x_valid {
    default 0;
    "~^0:(0)$" 1;
    "~^1:((?:0|1))$" 1;
    "~^2:((?:[0-2]|3))$" 1;
    "~^3:((?:[0-6]|7))$" 1;
    "~^4:((?:[0-9]|1[0-4]|15))$" 1;
    "~^5:((?:[0-9]|[1-2][0-9]{1}|30|31))$" 1;
    "~^6:((?:[0-9]|[1-5][0-9]{1}|6[0-2]|63))$" 1;
    "~^7:((?:[0-9]|[1-9][0-9]{1}|1[0-1][0-9]{1}|12[0-6]|127))$" 1;
